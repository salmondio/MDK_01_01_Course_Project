<Window x:Class="Course_project_wpf.Windows.MainWindowAuthorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Course_project_wpf.Windows"
        mc:Ignorable="d"
        KeyDown="WindowKeyDown"
            Title="Login" Height="430" MinHeight="430" MaxHeight="430" Width="350" MinWidth="350" MaxWidth="350">
    <Grid Background="{StaticResource BaseColor}">
        <StackPanel>
            <Label Content="Вход"
               HorizontalAlignment="Center"
               Margin="0, 50, 0, 0"
               FontSize="32"
                   Foreground="Black"/>
            <Label Content="Система оценки преподавателей"
               HorizontalAlignment="Center"
               Margin="0, 10, 0, 0"
               FontSize="14"
                   Foreground="Black"/>
            <Label Content="Логин"
               Width="260"
               Margin="0, 30, 0, 0"
               FontSize="16"
                   Foreground="Black"/>
            <TextBox x:Name="tbEmail"
                 Width="260"
                 Height="30"
                 VerticalContentAlignment="Center"
                   Foreground="Black"
                     Text="serg.serzhaninOwner@yandex.ru"/>
            <Label Content="Пароль"
               Width="260"
               Margin="0, 10, 0, 0"
               FontSize="16"
                   Foreground="Black"/>
            <PasswordBox x:Name="pbPassword"
                     Width="260"
                     Height="30"
                     VerticalContentAlignment="Center"
                   Foreground="Black"
                         />
            <Button x:Name="btnLogIn"
                    Style="{StaticResource HoverOverButtonUpdate}"
                    Click="LogIn"
                    Height="40"
                    Width="100"
                    Margin="0, 30, 0, 0"
                    Background="#1565C0"
                    Foreground="White"
                    Content="Войти"/>
        </StackPanel>
    </Grid>
</Window>
