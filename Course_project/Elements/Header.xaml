<UserControl x:Class="Course_project_wpf.Elements.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Course_project_wpf.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="MainGrid"
      Height="50"
      VerticalAlignment="Top"
      Background="{StaticResource OwnerColor}">
        <Label x:Name="RoleName"
                Content="Owner"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="White"
                Margin="10, 0, 0, 0"/>
        <StackPanel Orientation="Horizontal"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right">
            <TabControl x:Name="tcPages"
                        Height="Auto"
                        SelectionChanged="TabControl_SelectionChanged">
            </TabControl>
            <ToggleButton x:Name="MenuButton"
                    Checked="MenuButton_Checked"
                    Unchecked="MenuButton_Unchecked"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="10, 0, 10, 0"
                    VerticalAlignment="Center"
                    FocusVisualStyle="{x:Null}">
                <ToggleButton.Resources>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Resources>
                <Image Source="\Resources\Icons\ThreeBards.png"
                   Height="25"/>
            </ToggleButton>
        </StackPanel>

        <!-- Popup с меню -->
        <Popup x:Name="MenuPopup"
                Closed="MenuPopup_Closed"
                PlacementTarget="{Binding ElementName=MenuButton}"
                Placement="Bottom"
                HorizontalOffset="-170"
                VerticalOffset="+5"
                StaysOpen="False"
                AllowsTransparency="True">
            <Border x:Name="MenuBorder"
                    Background="White" 
                    CornerRadius="8" 
                    BorderBrush="#DADCE0" 
                    BorderThickness="1"
                    Margin="0,5,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" 
                          ShadowDepth="2" 
                          Opacity="0.15"/>
                </Border.Effect>
                <ListBox x:Name="MenuListBox"
                         Style="{StaticResource DropdownMenuStyle}"
                         SelectionChanged="MenuListBox_SelectionChanged">
                    <Separator Margin="0,5" Background="#DADCE0" Height="1"/>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/Icons/LogoutIcon.png" 
                                   Width="16" Height="16" 
                                   Margin="0,0,10,0"/>
                            <TextBlock Text="Выйти"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
