<UserControl x:Class="Course_project_wpf.Elements.OwnerAdmin.User"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="80" Width="800">

    <UserControl.Resources>
        <!-- Чистый стиль для кнопок без стандартных эффектов -->
        <Style x:Key="CleanButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="/Resources/Fonts/Inter/#Inter"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" 
                                    Property="Background" 
                                    Value="{DynamicResource LocalDarkColorTheme}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" 
                                    Property="Background" 
                                    Value="{DynamicResource LocalColorTheme}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для статусного индикатора -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <!-- Конвертер для выбора цвета роли -->
        <local:RoleToColorConverter x:Key="RoleToColorConverter"/>
        <local:RoleToDarkColorConverter x:Key="RoleToDarkColorConverter"/>
        <local:ActiveToOpacityConverter x:Key="ActiveToOpacityConverter"/>
    </UserControl.Resources>

    <!-- Border для пэддингов -->
    <Border Padding="0, 5, 0, 5"
            Height="80"
            MouseEnter="MainGrid_MouseEnter"
            MouseLeave="MainGrid_MouseLeave"
            Background="Transparent">

        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <!-- ID и активность -->
            <Border x:Name="bdId"
                    CornerRadius="8, 0, 0, 8"
                    ClipToBounds="True"
                    Background="{StaticResource LocalColorTheme}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ID -->
                    <Label x:Name="lbId"
                           Grid.Row="0"
                           Content="1"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"/>

                    <TextBox x:Name="tbId"
                             Grid.Row="0"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="20"
                             FontWeight="Bold"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="Collapsed"
                             TextChanged="tbId_TextChanged"/>

                    <!-- Статус активности -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0, 0, 0, 5">
                        <Border x:Name="ActiveIndicator"
                                Style="{StaticResource StatusIndicatorStyle}"
                                Background="#4CAF50"/>
                        <TextBlock x:Name="lbActive"
                                   Text="Активен"
                                   FontSize="10"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ФИО -->
            <Border x:Name="bdName"
                    Grid.Column="1"
                    Background="{StaticResource LocalColorTheme}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Фамилия Имя -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="10, 0, 0, 5">
                        <TextBlock x:Name="lbLastname"
                                   Text="Иванов"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="lbName"
                                   Text=" Иван"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </StackPanel>

                    <TextBox x:Name="tbLastname"
                             Grid.Row="0"
                             Text="Иванов"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="White"
                             Visibility="Collapsed"
                             VerticalAlignment="Bottom"
                             Margin="10, 0, 0, 5"/>

                    <TextBox x:Name="tbName"
                             Grid.Row="0"
                             Text="Иван"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="White"
                             Visibility="Collapsed"
                             VerticalAlignment="Bottom"
                             Margin="80, 0, 0, 5"/>

                    <!-- Отчество -->
                    <TextBlock x:Name="lbSurname"
                               Grid.Row="1"
                               Text="Иванович"
                               FontSize="14"
                               Foreground="#E0E0E0"
                               VerticalAlignment="Top"
                               Margin="10, 5, 0, 0"/>

                    <TextBox x:Name="tbSurname"
                             Grid.Row="1"
                             Text="Иванович"
                             FontSize="14"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="#E0E0E0"
                             Visibility="Collapsed"
                             VerticalAlignment="Top"
                             Margin="10, 5, 0, 0"/>
                </Grid>
            </Border>

            <!-- Email -->
            <Border x:Name="bdEmail"
                    Grid.Column="2"
                    Background="{StaticResource LocalColorTheme}">
                <Grid>
                    <TextBlock x:Name="lbEmail"
                               Text="user@example.com"
                               FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10, 0, 0, 0"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBox x:Name="tbEmail"
                             Text="user@example.com"
                             FontSize="14"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="White"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="10, 0, 0, 0"/>
                </Grid>
            </Border>

            <!-- Телефон -->
            <Border x:Name="bdPhone"
                    Grid.Column="3"
                    Background="{StaticResource LocalColorTheme}">
                <Grid>
                    <TextBlock x:Name="lbPhone"
                               Text="+7 (999) 123-45-67"
                               FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10, 0, 0, 0"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBox x:Name="tbPhone"
                             Text="+7 (999) 123-45-67"
                             FontSize="14"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="White"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="10, 0, 0, 0"/>
                </Grid>
            </Border>

            <!-- Роль -->
            <Border x:Name="bdRole"
                    Grid.Column="4"
                    CornerRadius="0"
                    ClipToBounds="True"
                    Background="{StaticResource LocalColorTheme}">
                <Grid>
                    <TextBlock x:Name="lbRole"
                               Text="Студент"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <ComboBox x:Name="cbRole"
                              Visibility="Collapsed"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Margin="5, 0, 5, 0"
                              Background="Transparent"
                              Foreground="White"
                              BorderBrush="White"
                              FontSize="14"/>
                </Grid>
            </Border>

            <!-- Действия -->
            <Border x:Name="bdActions"
                    Grid.Column="5"
                    CornerRadius="0, 8, 8, 0"
                    ClipToBounds="True"
                    Background="{StaticResource LocalColorTheme}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Изменить -->
                    <Button x:Name="EditButton"
                            Click="Update"
                            Grid.Column="0"
                            Style="{StaticResource CleanButtonStyle}"
                            Margin="5, 0, 5, 0"
                            Visibility="Collapsed">
                        <Image Source="/Resources/Icons/EditWhite.png"
                               Height="30"
                               Width="30"/>
                    </Button>

                    <!-- Сохранить -->
                    <Button x:Name="SaveButton"
                            Click="Save"
                            Grid.Column="0"
                            Style="{StaticResource CleanButtonStyle}"
                            Margin="5, 0, 5, 0"
                            Visibility="Collapsed">
                        <Image Source="/Resources/Icons/SaveWhite.png"
                               Height="30"
                               Width="30"/>
                    </Button>

                    <!-- Удалить -->
                    <Button x:Name="DeleteButton"
                            Click="Delete"
                            Grid.Column="1"
                            Style="{StaticResource CleanButtonStyle}"
                            Margin="5, 0, 5, 0"
                            Visibility="Collapsed">
                        <Image Source="/Resources/Icons/DeleteWhite.png"
                               Height="30"
                               Width="30"/>
                    </Button>

                    <!-- Отменить -->
                    <Button x:Name="CancelButton"
                            Click="Cancel"
                            Grid.Column="1"
                            Style="{StaticResource CleanButtonStyle}"
                            Margin="5, 0, 5, 0"
                            Visibility="Collapsed">
                        <Image Source="/Resources/Icons/CancelWhite.png"
                               Height="30"
                               Width="30"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>