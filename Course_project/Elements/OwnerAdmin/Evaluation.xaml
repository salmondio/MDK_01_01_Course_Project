<UserControl x:Class="Course_project_wpf.Elements.OwnerAdmin.Evaluation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Course_project_wpf.Elements.OwnerAdmin"
             mc:Ignorable="d" 
             d:DesignHeight="450" Width="800">
    <Grid x:Name="MainGrid"
          Height="70">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <!-- Кто кому -->
        <Grid x:Name="gdPeople"
              Grid.Column="0"
                Background="#6A9C78">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:Name="Student"
                    Click="GoToStudent"
                    Content="Сержанин Сергей Александрович"
                    Background="Transparent"
                    BorderThickness="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="15, 0, 0, 0"/>
            <Button x:Name="Teacher"
                    Click="GoToTeacher"
                    Content="Ощепков Александр Попович"
                    Background="Transparent"
                    BorderThickness="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Grid.Row="1"
                    Margin="15, 0, 0, 0"/>
        </Grid>
        
        <!-- Оценки -->
        <Grid x:Name="gdEvaluation"
              Grid.Column="1"
                Background="#6A9C78">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Оценка подачи материала -->
            <StackPanel>
                <Label x:Name="Presentation"
                       Content="9"
                       HorizontalContentAlignment="Center"/>
                <Image Grid.Row="1"  Source="/Resources/Icons/Presentation2.png"
                       Height="30"
                       HorizontalAlignment="Center"/>
            </StackPanel>
            <!-- Оценка подачи материала -->
            <StackPanel Grid.Column="1">
                <Label x:Name="Responsiveness"
                        Content="9"
                        HorizontalContentAlignment="Center"/>
                <Image Source="/Resources/Icons/Responsiveness.png"
                       Height="30"/>
            </StackPanel>
            <!-- Оценка подачи материала -->
            <StackPanel Grid.Column="2">
                <Label x:Name="Attitude"
                       Content="9"
                       HorizontalContentAlignment="Center"/>
                <Image Source="/Resources/Icons/Attitude.png"
                       Height="30"/>
            </StackPanel>
        </Grid>

        <!-- Дата и время -->
        <Grid x:Name="gdDateTime"
              Grid.Column="2"
                Background="#6A9C78">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label x:Name="lbDate"
                   Grid.Row="0"
                   Content="01.10.2026"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"/>
            <Label x:Name="lbTime"
                   Grid.Row="1"
                   Content="10:51"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="top"/>
        </Grid>

        <!-- Действия -->
        <Grid Name="gdActions"
              Grid.Column="3"
              Background="{x:Null}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="EditButton"
                    Click="Update"
                    Grid.Column="0"
                    Style="{StaticResource HoverOverButtonUpdate}"
                    Margin="5, 0, 5, 0">
                <Image Source="/Resources/Icons/Edit.png"
                       Height="35"/>
            </Button>
            <Button x:Name="DeleteButton"
                    Click="Delete"
                    Grid.Column="1"
                    Style="{StaticResource HoverOverButtonDelete}">
                <Image Source="/Resources/Icons/Delete.png"
                       Height="35"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
