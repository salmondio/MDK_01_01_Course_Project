<UserControl x:Class="Course_project_wpf.Elements.OwnerAdmin.Report"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Course_project_wpf.Elements.OwnerAdmin"
             mc:Ignorable="d" 
             d:DesignHeight="90" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="CleanButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="/Resources/Fonts/Inter/#Inter"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource LocalColorTheme}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" 
                                    Property="Background" 
                                    Value="{DynamicResource LocalDarkColorTheme}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" 
                                    Property="Background" 
                                    Value="{DynamicResource LocalColorTheme}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Resources/Fonts/Inter/#Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="/Resources/Fonts/Inter/#Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ReportTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="/Resources/Fonts/Inter/#Inter"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Border Padding="0, 5, 0, 5"
            MouseEnter="MainGrid_MouseEnter"
            MouseLeave="MainGrid_MouseLeave"
            Background="Transparent">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Основная строка -->
            <Border x:Name="MainBorder"
                    Grid.Row="0"
                    CornerRadius="8"
                    Background="{DynamicResource LocalColorTheme}"
                    Height="80">

                <Grid x:Name="MainGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- ID -->
                    <Border x:Name="bdId"
                            Grid.Column="0"
                            Width="50"
                            CornerRadius="8, 0, 0, 8"
                            Background="{DynamicResource LocalColorTheme}">
                        <Label x:Name="lbId"
                                Content="1"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"/>
                    </Border>

                    <!-- От кого и кому -->
                    <Grid x:Name="gdPeople"
                            Grid.Column="1"
                            Background="{DynamicResource LocalColorTheme}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="Sender"
                                Style="{StaticResource CleanButtonStyle}"
                                MouseEnter="SenderButton_MouseEnter"
                                MouseLeave="SenderButton_MouseLeave"
                                Click="GoToSender"
                                Content="Не удалось найти отправителя"
                                Padding="10, 0, 0, 0"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                FontSize="16"
                                Cursor="Hand"/>

                        <Button x:Name="Receiver"
                                Style="{StaticResource CleanButtonStyle}"
                                MouseEnter="ReceiverButton_MouseEnter"
                                MouseLeave="ReceiverButton_MouseLeave"
                                Click="GoToReceiver"
                                Content="Не удалось найти получателя"
                                Padding="10, 0, 0, 0"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Grid.Row="1"
                                FontSize="16"
                                Cursor="Hand"/>
                    </Grid>

                    <!-- Текст жалобы -->
                    <Border x:Name="bdText"
                            Grid.Column="2"
                            Background="{DynamicResource LocalColorTheme}"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnTextClick">
                        <Grid>
                            <TextBlock x:Name="lbText"
                                       Text="Текст жалобы"
                                       FontSize="14"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10, 0, 0, 0"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"/>

                            <TextBox x:Name="tbText"
                                     Style="{StaticResource ReportTextBoxStyle}"
                                     Margin="5"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Stretch"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Дата, время и статус -->
                    <Border x:Name="bdDateTime"
                            Grid.Column="3"
                            Width="90"
                            CornerRadius="0"
                            Background="{DynamicResource LocalColorTheme}">
                        <Grid x:Name="gdDateTime">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Дата -->
                            <Label x:Name="lbDate"
                                    Grid.Row="0"
                                    Content="01.10.2026"
                                    FontSize="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Foreground="White"/>

                            <!-- Время -->
                            <Label x:Name="lbTime"
                                    Grid.Row="1"
                                    Content="10:51"
                                    FontSize="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Foreground="White"/>

                            <!-- Статус (всегда виден) -->
                            <TextBlock x:Name="lbStatus"
                                       Grid.Row="2"
                                       Text="Новая"
                                       Style="{StaticResource StatusTextStyle}"
                                       Margin="0, 2, 0, 5"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Действия -->
                    <Border x:Name="bdActions"
                            Grid.Column="4"
                            CornerRadius="0, 8, 8, 0"
                            Background="{DynamicResource LocalColorTheme}">
                        <Grid Name="gdActions">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="EditButton"
                                    Click="EditButton_Click"
                                    Grid.Column="0"
                                    Style="{StaticResource HoverOverButtonUpdate}"
                                    Margin="5, 0, 5, 0"
                                    Visibility="Collapsed"
                                    ToolTip="Редактировать жалобу">
                                <TextBlock Text="✎" FontSize="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>

                            <Button x:Name="SaveButton"
                                    Click="SaveButton_Click"
                                    Grid.Column="0"
                                    Style="{StaticResource HoverOverButtonUpdate}"
                                    Margin="5, 0, 5, 0"
                                    Background="#4CAF50"
                                    Visibility="Collapsed"
                                    ToolTip="Сохранить изменения">
                                <TextBlock Text="✓" FontSize="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>

                            <Button x:Name="DeleteButton"
                                    Click="Delete"
                                    Grid.Column="1"
                                    Style="{StaticResource HoverOverButtonDelete}"
                                    Margin="5, 0, 5, 0"
                                    Visibility="Collapsed"
                                    ToolTip="Удалить жалобу">
                                <TextBlock Text="✕" FontSize="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>

                            <Button x:Name="CancelButton"
                                    Click="CancelButton_Click"
                                    Grid.Column="1"
                                    Style="{StaticResource HoverOverButtonDelete}"
                                    Margin="5, 0, 5, 0"
                                    Background="#FF9800"
                                    Visibility="Collapsed"
                                    ToolTip="Отменить изменения">
                                <TextBlock Text="↺" FontSize="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Разворачиваемая область -->
            <Border x:Name="ExpandedArea"
                    Grid.Row="1"
                    Background="{DynamicResource LocalColorTheme}"
                    CornerRadius="0, 0, 8, 8"
                    Visibility="Collapsed"
                    Margin="0, -5, 0, 5">
                <Border Margin="10, 10, 10, 15">
                    <ScrollViewer MaxHeight="200"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="lbFullText"
                                   Text=""
                                   FontSize="14"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>