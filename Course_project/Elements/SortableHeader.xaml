<UserControl x:Class="Course_project_wpf.Elements.SortableHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Course_project_wpf.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#F1F3F4" 
            BorderBrush="#DADCE0" 
            BorderThickness="0,0,0,1"
            Padding="5">
        <WrapPanel x:Name="HeadersPanel">
            <!-- Кнопки будут добавляться динамически -->
        </WrapPanel>
    </Border>
</UserControl>
