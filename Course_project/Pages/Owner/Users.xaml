<Page x:Class="Course_project_wpf.Pages.Owner.Users"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Course_project_wpf.Pages.Owner"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="Users">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с сортировкой -->
        <Border Grid.Row="0" Padding="100 0 100 0">
            <Grid x:Name="Search"/>
        </Border>

        <!-- Список пользователей -->
        <Grid x:Name="Body"
              Grid.Row="1">
            <ScrollViewer>
                <Border Padding="100 0 100 0">
                    <StackPanel x:Name="Parent"/>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Нижний колонтитул -->
        <Grid x:Name="Footer"
              Grid.Row="2"/>
    </Grid>
</Page>